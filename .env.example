# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Supabase -> Project Settings -> API -> service_role
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe -> Product catalog -> Prices
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# Stripe -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Reminder email delivery (server only)
RESEND_API_KEY=re_...
REMINDER_FROM_EMAIL=DoneDate <reminders@technicade.tech>
CRON_SECRET=replace-with-a-long-random-secret

# Production site URL. Use the canonical production domain in Vercel.
NEXT_PUBLIC_APP_URL=https://donedate.technicade.tech
